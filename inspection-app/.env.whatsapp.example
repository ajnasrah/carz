# WhatsApp Business API Configuration
# Copy this file to Vercel Environment Variables

# Your WhatsApp Verify Token (you create this)
WHATSAPP_VERIFY_TOKEN=carz_whatsapp_verify_2024

# WhatsApp Business API Access Token
# Get from: https://developers.facebook.com/apps/YOUR_APP_ID/whatsapp-business/wa-dev-console
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Phone Number ID
# Get from: WhatsApp Business API dashboard
WHATSAPP_PHONE_NUMBER_ID=

# Supabase Service Role Key (for server-side operations)
# Get from: https://supabase.com/dashboard/project/yprihgygmreibcuybwoy/settings/api
# Use the "service_role" key, NOT the anon key
SUPABASE_SERVICE_KEY=