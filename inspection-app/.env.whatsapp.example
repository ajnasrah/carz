# WhatsApp Cloud API — Vercel Environment Variables
# Set each of these with: vercel env add <NAME> production   (and `preview` too)
# NEVER commit real values.

# Webhook verify token — you invent this string; must match what you enter in
# the Meta dashboard webhook config. Read by api/whatsapp.js from the env (no
# longer hardcoded).
WHATSAPP_VERIFY_TOKEN=carz_whatsapp_verify_2024

# Meta App Secret — App → Settings → Basic → "App Secret".
# Used to verify the X-Hub-Signature-256 on every inbound webhook. REQUIRED;
# without it the webhook rejects all POSTs.
WHATSAPP_APP_SECRET=

# Permanent System User access token (NOT the 24h dev-console token).
# Business Settings → Users → System Users → Admin → Generate token with
# whatsapp_business_messaging + whatsapp_business_management. Used to download
# inbound media from the Graph API.
WHATSAPP_ACCESS_TOKEN=

# Supabase — service_role key (NOT anon). Server-side, bypasses RLS.
# https://supabase.com/dashboard/project/yprihgygmreibcuybwoy/settings/api
SUPABASE_URL=https://yprihgygmreibcuybwoy.supabase.co
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# NOTE: the station → number mapping lives in the DB table wa_station_numbers
# (one row per phone_number_id), NOT in env, so adding a number needs no
# redeploy. Seed it after registering your numbers — see the migration
# 20260621000002_whatsapp_inbound.sql for the INSERT example.
#
# Allowed worker numbers live in wa_allowed_senders. Anyone not listed there
# is ignored by the webhook.
# ---------------------------------------------------------------------------
