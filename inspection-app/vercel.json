{
  "redirects": [
    {
      "source": "/cars",
      "destination": "https://docs.google.com/spreadsheets/d/15Tkj9SS-YbS1qs6GM0uVjKLEbIhRTbXZZiv1OfphWzM/edit?usp=sharing",
      "permanent": false
    },
    {
      "source": "/inventory",
      "destination": "https://docs.google.com/spreadsheets/d/15Tkj9SS-YbS1qs6GM0uVjKLEbIhRTbXZZiv1OfphWzM/edit?usp=sharing",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!training/|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self)" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
