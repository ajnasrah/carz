{
  "redirects": [
    {
      "source": "/cars",
      "destination": "/marketplace",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/marketplace/:id",
      "destination": "/api/listing-og?id=:id"
    },
    {
      "source": "/((?!training/|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self)"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/sms-nudge",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/intake-sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/photo-sort",
      "schedule": "*/15 * * * *"
    }
  ]
}
