<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac puller for the WhatsApp Cloud API pipeline.
  Runs scrapers/whatsapp_pull.py every 60s (one-shot; idempotent).
  The service_role key is NOT here — the script reads it from
  ~/Library/Application Support/CarzInc/.env  (key line: SUPABASE_SERVICE_KEY=...).

  Install:
    cp "/Users/abdullahabunasrah/Desktop/carz inc/scrapers/com.carzinc.whatsapp-pull.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.carzinc.whatsapp-pull.plist
  Logs: ~/Library/Logs/carzinc-whatsapp-pull.log
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carzinc.whatsapp-pull</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/abdullahabunasrah/.pyenv/versions/3.12.11/bin/python3</string>
        <string>/Users/abdullahabunasrah/Desktop/carz inc/scrapers/whatsapp_pull.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/abdullahabunasrah/Desktop/carz inc/scrapers</string>

    <!-- Run once now, then every 60 seconds. One-shot + idempotent, so a crash
         just means the next tick retries — no stuck process to babysit. -->
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/Users/abdullahabunasrah/Library/Logs/carzinc-whatsapp-pull.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/abdullahabunasrah/Library/Logs/carzinc-whatsapp-pull.log</string>
</dict>
</plist>
